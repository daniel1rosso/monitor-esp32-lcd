COMPOSE_PROJECT_NAME=desk-monitor

# Host Nginx listens on port 80. Containers stay bound to loopback only.
DESK_FRONTEND_BIND_ADDRESS=127.0.0.1
DESK_FRONTEND_PORT=9095
DESK_BACKEND_BIND_ADDRESS=127.0.0.1
DESK_BACKEND_PORT=9096
DESK_MQTT_BIND_ADDRESS=127.0.0.1
DESK_MQTT_WS_PORT=9097
DESK_MQTT_PUBLIC_URL=wss://monitor.danielalbertorosso.com.ar/mqtt

DESK_VERSION=dev
DESK_COMMIT=unknown
DESK_BUILT_AT=unknown
DESK_CPU_LIMIT=1.0
DESK_MEMORY_LIMIT=512M
DESK_LOG_LEVEL=info

# Set both values only for the first startup of a new backend data volume.
DESK_BOOTSTRAP_ADMIN_EMAIL=
DESK_BOOTSTRAP_ADMIN_PASSWORD=

# Leave DATABASE_URL empty while production uses SQLite.
DATABASE_URL=

# Empty infrastructure passwords are generated and persisted on first startup.
MOSQUITTO_ADMIN_PASSWORD=
REDIS_PASSWORD=

GITHUB_WEBHOOK_SECRET=
GITHUB_ACTIONS_TOKEN=
UPTIME_KUMA_TOKEN=
POTRERITO_API_TOKEN=
