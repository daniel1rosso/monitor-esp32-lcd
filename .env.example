COMPOSE_PROJECT_NAME=desk-monitor

# Local: :8080. Production: monitor.example.com for automatic HTTPS.
DESK_SITE_ADDRESS=:8080
DESK_BIND_ADDRESS=127.0.0.1
DESK_LOCAL_HTTP_PORT=8180
DESK_HTTP_PORT=80
DESK_HTTPS_PORT=443
DESK_CPU_LIMIT=1.0
DESK_MEMORY_LIMIT=512M
DESK_LOG_LEVEL=info

# Optional one-time admin bootstrap. Both values must be provided together.
DESK_BOOTSTRAP_ADMIN_EMAIL=
DESK_BOOTSTRAP_ADMIN_PASSWORD=
DESK_MQTT_PUBLIC_URL=ws://localhost:9001/mqtt

# Required only when storage.driver is postgres.
DATABASE_URL=

# Optional. Empty values are safe while services remain on the private Docker network.
# Mosquitto generates and persists a random admin password when this is empty.
MOSQUITTO_ADMIN_PASSWORD=
REDIS_PASSWORD=

# Application integrations are required only when their modules are enabled.
GITHUB_WEBHOOK_SECRET=
GITHUB_ACTIONS_TOKEN=
UPTIME_KUMA_TOKEN=
POTRERITO_API_TOKEN=
